# Base de datos (libSQL / Turso). En local usa un archivo SQLite.
DATABASE_URL=file:local.db
# Solo para Turso en producción:
DATABASE_AUTH_TOKEN=

# Acceso al panel /admin
ADMIN_PASSWORD=cambia-esta-clave
# Cadena aleatoria de 32+ caracteres (ej: openssl rand -base64 32)
SESSION_SECRET=

# Dominio público (para sitemap y robots), ej: https://barberiaohiggins.cl
NEXT_PUBLIC_SITE_URL=
